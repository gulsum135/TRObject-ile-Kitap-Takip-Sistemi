   Author.Margins.left = 7;
   Author.Height = DPanl.Height/5;
   Author.SetclProSettings(BookName.clProSettings);
   DPanl.AddPanelObject(Author,clText1);
   
   Category = Form1.AddNewProLabel(DPanl,'Category','-');
   Category.Align = alMostTop;
